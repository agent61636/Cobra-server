<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test stand-ins for LaunchBox's plugin API, so CI can build without LaunchBox. Never shipped. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Unbroken.LaunchBox.Plugins</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
